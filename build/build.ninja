  TARGET_FILE = libminkowski_cpp.a
  TARGET_PDB = libminkowski_cpp.pdb

# =============================================================================
# Object build statements for EXECUTABLE target train


#############################################
# Order-only phony target for train

build cmake_object_order_depends_target_train: phony || cmake_object_order_depends_target_minkowski_cpp cmake_object_order_depends_target_minkowski_kernel

build CMakeFiles/train.dir/tests/train.cpp.o: CXX_COMPILER__train_ /workspace/tests/train.cpp || cmake_object_order_depends_target_train
  DEFINES = -DMINK_NO_PYBIND -DUSE_C10D_GLOO -DUSE_C10D_NCCL -DUSE_CUDA -DUSE_DISTRIBUTED -DUSE_RPC -DUSE_TENSORPIPE
  DEP_FILE = CMakeFiles/train.dir/tests/train.cpp.o.d
  FLAGS = -D_GLIBCXX_USE_CXX11_ABI=1 -fopenmp -D_GLIBCXX_USE_CXX11_ABI=1 -fopenmp -std=c++17
  INCLUDES = -I/workspace -I/workspace/MinkowskiEngine -I/workspace/MinkowskiEngine/src -I/workspace/MinkowskiEngine/src/3rdparty -I/workspace/third_party -I/usr/local/cuda/include/cccl -isystem /usr/local/cuda/include -isystem /opt/libtorch/include -isystem /opt/libtorch/include/torch/csrc/api/include
  OBJECT_DIR = CMakeFiles/train.dir
  OBJECT_FILE_DIR = CMakeFiles/train.dir/tests
  TARGET_COMPILE_PDB = CMakeFiles/train.dir/
  TARGET_PDB = train.pdb


# =============================================================================
# Link build statements for EXECUTABLE target train


#############################################
# Link the executable train

build train: CXX_EXECUTABLE_LINKER__train_ CMakeFiles/train.dir/tests/train.cpp.o | libminkowski_cpp.a /opt/libtorch/lib/libc10.so /opt/libtorch/lib/libkineto.a /usr/local/cuda/lib64/libnvrtc.so /opt/libtorch/lib/libc10_cuda.so libminkowski_kernel.a /opt/libtorch/lib/libtorch.so /opt/libtorch/lib/libc10_cuda.so /opt/libtorch/lib/libc10.so /opt/libtorch/lib/libc10.so /opt/libtorch/lib/libkineto.a /usr/local/cuda/lib64/libnvrtc.so /usr/local/cuda/lib64/libnvToolsExt.so /opt/libtorch/lib/libc10_cuda.so /usr/local/cuda/lib64/libcusparse.so /usr/local/cuda/lib64/libcublas.so /usr/local/cuda/lib64/libcublasLt.so /usr/local/cuda/lib64/libcudart.so /usr/lib/gcc/x86_64-linux-gnu/11/libgomp.so /usr/lib/x86_64-linux-gnu/libpthread.a || libminkowski_cpp.a libminkowski_kernel.a
  FLAGS = -D_GLIBCXX_USE_CXX11_ABI=1 -fopenmp
  LINK_LIBRARIES = -Wl,-rpath,/lib/intel64:/lib/intel64_win:/lib/win-x64:/opt/libtorch/lib:/usr/local/cuda/lib64  libminkowski_cpp.a  /opt/libtorch/lib/libc10.so  /opt/libtorch/lib/libkineto.a  /usr/local/cuda/lib64/libnvrtc.so  /opt/libtorch/lib/libc10_cuda.so  libminkowski_kernel.a  /opt/libtorch/lib/libtorch.so  -Wl,--no-as-needed,"/opt/libtorch/lib/libtorch_cpu.so" -Wl,--as-needed  -Wl,--no-as-needed,"/opt/libtorch/lib/libtorch_cuda.so" -Wl,--as-needed  /opt/libtorch/lib/libc10_cuda.so  /opt/libtorch/lib/libc10.so  -Wl,--no-as-needed,"/opt/libtorch/lib/libtorch.so" -Wl,--as-needed  /opt/libtorch/lib/libc10.so  /opt/libtorch/lib/libkineto.a  /usr/local/cuda/lib64/libnvrtc.so  /usr/local/cuda/lib64/libnvToolsExt.so  /opt/libtorch/lib/libc10_cuda.so  /usr/local/cuda/lib64/libcusparse.so  /usr/local/cuda/lib64/libcublas.so  /usr/local/cuda/lib64/libcublasLt.so  /usr/local/cuda/lib64/libcudart.so  /usr/lib/gcc/x86_64-linux-gnu/11/libgomp.so  /usr/lib/x86_64-linux-gnu/libpthread.a  -lcudadevrt  -lcudart_static  -lrt  -lpthread  -ldl
  LINK_PATH = -L/lib/intel64   -L/lib/intel64_win   -L/lib/win-x64   -L/usr/local/cuda/targets/x86_64-linux/lib
  OBJECT_DIR = CMakeFiles/train.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = CMakeFiles/train.dir/
  TARGET_FILE = train
  TARGET_PDB = train.pdb


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build && /usr/bin/cmake --regenerate-during-build -S/workspace -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build list_install_components: phony


#############################################
# Utility command for install

build CMakeFiles/install.util: CUSTOM_COMMAND all
  COMMAND = cd /workspace/build && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build install: phony CMakeFiles/install.util


#############################################
# Utility command for install/local

build CMakeFiles/install/local.util: CUSTOM_COMMAND all
  COMMAND = cd /workspace/build && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build install/local: phony CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build CMakeFiles/install/strip.util: CUSTOM_COMMAND all
  COMMAND = cd /workspace/build && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build install/strip: phony CMakeFiles/install/strip.util

