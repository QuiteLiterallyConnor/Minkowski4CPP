# Inspect the configured library target's actual sources, rather than a second
# reconstruction of the source-glob rules. The unified .cu owns CPU definitions.
if(NOT DEFINED SOURCE_FILE OR NOT EXISTS "${SOURCE_FILE}")
    message(FATAL_ERROR "Configured library source list is missing")
endif()
file(READ "${SOURCE_FILE}" sources)
set(unified_count 0)
foreach(source IN LISTS sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "coordinate_manager.cpp")
        message(FATAL_ERROR "CPU library includes the legacy CoordinateManager definitions")
    elseif(name STREQUAL "coordinate_manager.cu")
        math(EXPR unified_count "${unified_count} + 1")
    endif()
endforeach()
if(NOT unified_count EQUAL 1)
    message(FATAL_ERROR "CPU library must include exactly one unified CoordinateManager implementation; found ${unified_count}")
endif()
message(STATUS "CPU library has exactly one canonical CoordinateManager implementation")
