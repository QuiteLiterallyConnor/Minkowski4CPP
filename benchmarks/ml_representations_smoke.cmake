# Runs every method of ml_representations for one epoch on a tiny dataset and
# checks fresh result JSONs. Usage: cmake -DEXE=... -DOUT=... -P this
# Explicit auto preserves the smoke's CPU fallback; real CUDA studies must request cuda.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef attempt)
set(run_out "${OUT}/attempt-${attempt}")
file(MAKE_DIRECTORY "${run_out}")

function(read_field output expected_type)
    string(JSON value_type ERROR_VARIABLE type_error TYPE "${record}" ${ARGN})
    string(JSON value ERROR_VARIABLE value_error GET "${record}" ${ARGN})
    if(NOT type_error STREQUAL "NOTFOUND" OR NOT value_error STREQUAL "NOTFOUND"
       OR NOT value_type STREQUAL "${expected_type}")
        message(FATAL_ERROR "Expected ${expected_type} at ${ARGN} in ${result}")
    endif()
    if(expected_type STREQUAL "NUMBER"
       AND NOT "${value}" MATCHES "^-?[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$")
        message(FATAL_ERROR "Expected finite number at ${ARGN} in ${result}")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

foreach(method uniform adaptive gaussian adaptive_gaussian)
    set(result "${run_out}/${method}.json")
    execute_process(
        COMMAND "${EXE}" --method ${method} --seed 1 --epochs 1 --device auto
                --train-per-class 3 --test-per-class 2 --points 512
                --output "${result}"
        RESULT_VARIABLE rc)
    if(NOT "${rc}" STREQUAL "0")
        message(FATAL_ERROR "ml_representations --method ${method} failed: ${rc}")
    endif()
    if(NOT EXISTS "${result}")
        message(FATAL_ERROR "ml_representations --method ${method} wrote no result")
    endif()
    file(READ "${result}" record)
    foreach(field method seed epochs train_samples test_samples points_per_sample)
        if(field STREQUAL "method")
            read_field(value STRING ${field})
            set(expected "${method}")
        else()
            read_field(value NUMBER ${field})
            if(field STREQUAL "train_samples")
                set(expected "30")
            elseif(field STREQUAL "test_samples")
                set(expected "20")
            elseif(field STREQUAL "points_per_sample")
                set(expected "512")
            else()
                set(expected "1")
            endif()
        endif()
        if(NOT "${value}" STREQUAL "${expected}")
            message(FATAL_ERROR "Unexpected ${field}=${value}, expected ${expected}: ${result}")
        endif()
    endforeach()
    read_field(device STRING device)
    if(NOT device STREQUAL "cpu" AND NOT device STREQUAL "cuda")
        message(FATAL_ERROR "Unexpected device=${device} in ${result}")
    endif()
    read_field(accuracy NUMBER accuracy)
    if(accuracy LESS 0 OR accuracy GREATER 1)
        message(FATAL_ERROR "Accuracy outside [0, 1] in ${result}")
    endif()
    read_field(curve ARRAY curve)
    string(JSON curve_size LENGTH "${record}" curve)
    if(NOT curve_size EQUAL 1)
        message(FATAL_ERROR "Expected one completed epoch in ${result}")
    endif()
    read_field(epoch NUMBER curve 0 epoch)
    if(NOT epoch EQUAL 1)
        message(FATAL_ERROR "Expected epoch 1 in ${result}")
    endif()
    foreach(field train_loss train_acc test_acc epoch_train_s)
        read_field(value NUMBER curve 0 ${field})
        if(value LESS 0)
            message(FATAL_ERROR "Negative ${field} in ${result}")
        endif()
        if(field MATCHES "_acc$" AND value GREATER 1)
            message(FATAL_ERROR "Accuracy outside [0, 1] in ${result}")
        endif()
    endforeach()
endforeach()
